# Modèle de configuration. Copier ce fichier en ".env" puis changer les valeurs :
#   cp .env.example .env
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être poussé sur GitHub.

DB_NAME=bibliotheque
DB_USER=biblio_user
DB_PASSWORD=change-moi
# Clé de signature des jetons JWT : une longue chaîne aléatoire, par exemple
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-moi-aussi
